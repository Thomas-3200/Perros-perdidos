# ─── Perros Perdidos — Variables de entorno ───────────────────────────────────
# Copiar a .env y completar con los valores reales.
# Las variables marcadas con [REQUERIDA] bloquean el inicio si faltan.
# Las marcadas con [OPCIONAL] degradan la funcionalidad con gracia si faltan.

# ─── Base de datos [REQUERIDA] ────────────────────────────────────────────────
# Dev local:  postgresql://perros:perros@localhost:5433/perros_perdidos
# Railway:    lo provee automáticamente como variable DATABASE_URL
# Supabase:   Settings → Database → Connection string (modo "Transaction")
DATABASE_URL="postgresql://user:password@host:5432/perros_perdidos"

# ─── Redis [REQUERIDA] ────────────────────────────────────────────────────────
# Dev local:  redis://localhost:6379
# Upstash:    redis://default:token@host.upstash.io:port
# Railway:    lo provee automáticamente como variable REDIS_URL
REDIS_URL="redis://localhost:6379"

# ─── JWT [REQUERIDA] ──────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
# NUNCA usar el valor de dev en producción.
JWT_SECRET="cambiar-por-string-largo-y-aleatorio-en-produccion"

# ─── Servidor [REQUERIDA] ─────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development   # cambiar a "production" en Railway/Render

# ─── CORS [REQUERIDA] ─────────────────────────────────────────────────────────
# Lista separada por comas. Agregar el dominio Vercel al deployar.
# Ejemplo producción: https://perros-perdidos.vercel.app,https://tu-dominio.com
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# ─── URL pública del backend [REQUERIDA en producción] ────────────────────────
# Se usa para construir URLs de imágenes en modo local (sin Cloudinary).
# En producción es el dominio de Railway, ej: https://api-perros.up.railway.app
API_BASE_URL="http://localhost:3001"

# ─── Cloudinary — almacenamiento de imágenes [REQUERIDA en producción] ────────
# Sin estas keys, las imágenes se guardan en disco local (./uploads/).
# En producción (Railway/Render) el disco es efímero: las fotos se pierden
# al reiniciar el servidor. Cloudinary es OBLIGATORIO para el pilot público.
#
# Crear cuenta en https://cloudinary.com (free tier: 25 GB, 25K transf/mes)
# Obtener en: Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── IA — Anthropic (Claude) [OPCIONAL] ──────────────────────────────────────
# Si vacío: /apoyo muestra pantalla "Próximamente". No bloquea el resto.
# Obtener en: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=""

# ─── IA — OpenAI [OPCIONAL] ──────────────────────────────────────────────────
# Si vacío: matching usa modo básico (geo + tiempo + atributos). Funciona bien.
OPENAI_API_KEY=""

# ─── IA — Replicate (CLIP embeddings) [OPCIONAL] ─────────────────────────────
# Si vacío: matching visual desactivado. Solo usa modo básico.
REPLICATE_API_TOKEN=""

# ─── OAuth Google [OPCIONAL] ─────────────────────────────────────────────────
# Callback autorizado: https://TU-API.render.com/api/v1/users/auth/google/callback
# Crear en: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OAuth Facebook [OPCIONAL] ───────────────────────────────────────────────
# Callback autorizado: https://TU-API.render.com/api/v1/users/auth/facebook/callback
# Crear en: https://developers.facebook.com → Tu app → Facebook Login
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Variables del FRONTEND (Next.js — van en apps/web/.env.local o en Vercel)
# Estas variables se exponen al browser. NUNCA poner secrets aquí.
# ─────────────────────────────────────────────────────────────────────────────

# URL del backend — accesible desde el browser del usuario [REQUERIDA]
# Dev:        http://localhost:3001
# Producción: https://api-perros.up.railway.app  (el dominio que asigna Railway)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Token de Mapbox para la página /mapa [OPCIONAL]
# Si vacío: la página /mapa muestra un placeholder "próximamente".
# Obtener en: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ─── Donaciones [OPCIONAL] ────────────────────────────────────────────────────
# Links externos de pago. Si vacíos: la página /donar muestra "próximamente".
# Mercado Pago: mercadopago.com.ar → Tu negocio → Cobros → Crear link de pago
# Ko-fi:        ko-fi.com → tu-usuario → Botón de Ko-fi → Link directo
# PayPal:       paypal.com/donate → Crear botón → Link directo
NEXT_PUBLIC_MP_DONATION_URL=""
NEXT_PUBLIC_KOFI_URL=""
NEXT_PUBLIC_PAYPAL_URL=""

# Google Client ID (mismo valor que GOOGLE_CLIENT_ID del backend) [OPCIONAL]
# Necesario para mostrar el botón "Continuar con Google" en el modal de login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Facebook App ID (mismo valor que FACEBOOK_APP_ID del backend) [OPCIONAL]
# Necesario para mostrar el botón "Continuar con Facebook" en el modal de login.
NEXT_PUBLIC_FACEBOOK_APP_ID=""
